{
  "name": "mashiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test:focused": "vitest run tests/unit tests/integration tests/renderer",
    "test": "vitest run",
    "test:electron": "npm run build && node scripts/electron-f1-harness.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "build": "electron-vite build",
    "pack:windows": "npm run build && electron-builder --config electron-builder.config.mjs --win --x64 --dir --publish never",
    "dist:windows": "npm run build && electron-builder --config electron-builder.config.mjs --win nsis --x64 --publish never",
    "verify": "npm run test:focused && npm test && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:electron"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
